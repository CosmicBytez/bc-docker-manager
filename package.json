{
  "name": "bc-container-manager",
  "version": "1.3.0",
  "description": "Business Central Docker Container Management Desktop App",
  "private": true,
  "main": "electron/main.js",
  "author": "CosmicBytez",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:electron": "cross-env ELECTRON_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "electron:dev": "concurrently \"next dev -p 3333\" \"wait-on http://localhost:3333 && electron .\"",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:build:win": "npm run build:electron && electron-builder --win",
    "electron:build:portable": "npm run build:electron && electron-builder --win portable",
    "electron:pack": "npm run build:electron && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "date-fns": "^3.6.0",
    "dockerode": "^4.0.12",
    "lucide-react": "^0.577.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/dockerode": "^4.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.10.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
